// Generated by matugen from the current wallpaper -- do not edit by hand,
// it gets overwritten on every session start and wallpaper change. Edit
// ~/.config/matugen/templates/fastfetch.jsonc instead.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch",
    "color": {
      "1": "{{colors.primary.default.hex}}",
      "2": "{{colors.tertiary.default.hex}}"
    },
    "padding": { "top": 1, "left": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "{{colors.primary.default.hex}}",
      "title": "{{colors.tertiary.default.hex}}",
      "output": "{{colors.on_surface.default.hex}}"
    },
    "key": { "width": 15 },
    "percent": { "type": 3 },
    "bar": { "width": 12 }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}{#{{colors.outline.default.hex}}}@{#}{host-name}"
    },
    {
      "type": "custom",
      "format": "\u256d\u2500 \uf013 system \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500",
      "outputColor": "{{colors.outline.default.hex}}"
    },
    { "type": "os",       "key": "\u2502 \udb82\udcc7 os",       "format": "{pretty-name}" },
    { "type": "kernel",   "key": "\u2502 \uf17c kernel" },
    { "type": "packages", "key": "\u2502 \udb80\udfd6 packages" },
    { "type": "uptime",   "key": "\u2502 \udb80\udd50 uptime" },
    {
      "type": "custom",
      "format": "\u251c\u2500 \udb80\udf79 desktop \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500",
      "outputColor": "{{colors.outline.default.hex}}"
    },
    { "type": "wm",           "key": "\u2502 \uf2d0 wm",       "format": "{pretty-name} {version}" },
    { "type": "shell",        "key": "\u2502 \uf120 shell",    "format": "{pretty-name} {version}" },
    { "type": "terminal",     "key": "\u2502 \ue795 terminal", "format": "{pretty-name} {version}" },
    { "type": "terminalfont", "key": "\u2502 \uf031 font" },
    { "type": "cursor",       "key": "\u2502 \udb80\uddbf cursor" },
    {
      "type": "custom",
      "format": "\u251c\u2500 \uf4bc hardware \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500",
      "outputColor": "{{colors.outline.default.hex}}"
    },
    { "type": "cpu",     "key": "\u2502 \udb83\udee0 cpu",     "temp": true, "format": "{name} ({cores-logical}) @ {freq-max} {temperature}" },
    { "type": "gpu",     "key": "\u2502 \udb82\udcae gpu",     "temp": true, "format": "{name} {temperature}" },
    { "type": "memory",  "key": "\u2502 \udb80\udf5b memory" },
    { "type": "disk",    "key": "\u2502 \udb80\udeca disk",    "folders": "/", "format": "{size-used} / {size-total} ({size-percentage})" },
    {
      "type": "custom",
      "format": "\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500",
      "outputColor": "{{colors.outline.default.hex}}"
    },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
