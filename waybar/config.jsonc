// Two bar objects: primary monitor gets the full module set, the other
// two get a reduced set (workspaces, clock, tray, pulseaudio only). Both
// include shared.jsonc for the common bar settings and every module's
// individual config (waybar's own `include` directive -- see
// waybar(5)'s "Configuration of multiple outputs" section).
[
  {
    "output": "DP-1",
    "include": ["shared.jsonc"],

    "modules-left": [
      "hyprland/workspaces",
      "custom/screenshot",
      "custom/clipboard"
    ],
    "modules-center": [
      "clock"
    ],
    "modules-right": [
      "tray",
      "cpu",
      "memory",
      "temperature",
      "network",
      "pulseaudio"
    ]
  },
  {
    "output": ["DP-2", "DP-3"],
    "include": ["shared.jsonc"],

    "modules-left": [
      "hyprland/workspaces",
      "custom/screenshot"
    ],
    "modules-center": [
      "clock"
    ],
    "modules-right": [
      "tray",
      "network",
      "pulseaudio"
    ]
  }
]
