#!/usr/bin/env bash
# screenshot-region (Print, waybar screenshot button)
#
# Select a region with slurp, save it to ~/Pictures/Screenshots and copy
# it to the clipboard.

set -uo pipefail

dir=$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Screenshots
mkdir -p "$dir"
file=$dir/$(date +%Y-%m-%d_%H-%M-%S).png

geom=$(slurp) || exit 0   # Esc cancels
grim -g "$geom" "$file" || exit 1
wl-copy --type image/png < "$file"
notify-send -i "$file" "Screenshot saved" "$(basename "$file") -- copied to clipboard"
