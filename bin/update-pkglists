#!/usr/bin/env bash
# update-pkglists
#
# Regenerates packages/pkglist-repo.txt, packages/pkglist-aur.txt and
# packages/flatpaks.txt from what's installed, so install.sh always rebuilds
# the current system. Run automatically after every pacman/yay transaction
# by the pacman hook in etc/pacman.d/hooks/ (as this user, not root), or by
# hand after adding/removing a Flatpak. Only rewrites a file when its
# package list actually changed; never commits -- that stays your call.

set -euo pipefail

REPO=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
DIR=$REPO/packages
changed=()

# write <file> <header> < list -- only touch the file if the list differs.
# (Fed by < <(...), not a pipe, so `changed` survives -- pipes run in a subshell.)
write() {
    local file=$1 header=$2 tmp
    tmp=$(mktemp)
    { printf '%s\n' "$header"; cat; } > "$tmp"
    if ! cmp -s <(grep -vE '^\s*(#|$)' "$tmp") <(grep -vsE '^\s*(#|$)' "$file"); then
        mv "$tmp" "$file"
        changed+=("$(basename "$file")")
    else
        rm -f "$tmp"
    fi
}

# Explicitly installed official packages. lib32-vulkan-radeon stays pinned so
# a fresh install picks the right 32-bit Vulkan driver for Steam.
write "$DIR/pkglist-repo.txt" \
"# Explicitly installed official-repo packages. Regenerated by bin/update-pkglists
# (lib32-vulkan-radeon pinned so Steam's 32-bit Vulkan provider is chosen correctly)" \
    < <({ pacman -Qqen; echo lib32-vulkan-radeon; } | sort -u)

# Explicitly installed AUR packages; install.sh bootstraps yay itself.
write "$DIR/pkglist-aur.txt" \
"# Explicitly installed AUR packages (yay itself is bootstrapped by install.sh).
# Regenerated by bin/update-pkglists" \
    < <(pacman -Qqem | grep -vE '^yay(-debug)?$' || true)

if command -v flatpak >/dev/null; then
    write "$DIR/flatpaks.txt" \
"# Flatpak apps, installed system-wide from Flathub by install.sh.
# Regenerated by bin/update-pkglists" \
        < <(flatpak list --system --app --columns=application)
fi

if [[ ${#changed[@]} -gt 0 ]]; then
    echo "update-pkglists: updated ${changed[*]} in $DIR (not committed)"
fi
