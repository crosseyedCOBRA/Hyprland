#!/usr/bin/env bash
# update-pkglists
#
# Regenerates the package lists from what's installed, so the install script
# always rebuilds the current system:
#   Arch:       packages/pkglist-repo.txt, pkglist-aur.txt, flatpaks.txt
#               (run after every pacman/yay transaction by the pacman hook in
#               etc/pacman.d/hooks/)
#   Tumbleweed: packages/tumbleweed/packages.txt, flatpaks.txt (run after
#               every zypper transaction by the commit plugin in
#               etc/zypp/plugins/commit/)
# Runs as this user, not root; run it by hand after adding/removing a
# Flatpak. Only rewrites a file when its package list actually changed;
# never commits -- that stays your call.

set -euo pipefail

REPO=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
DIR=$REPO/packages
changed=()

# write <file> <header> < list -- only touch the file if the list differs.
# (Fed by < <(...), not a pipe, so `changed` survives -- pipes run in a subshell.)
write() {
    local file=$1 header=$2 tmp
    tmp=$(mktemp)
    { printf '%s\n' "$header"; cat; } > "$tmp"
    if ! cmp -s <(grep -vE '^\s*(#|$)' "$tmp") <(grep -vsE '^\s*(#|$)' "$file"); then
        mv "$tmp" "$file"
        changed+=("$(basename "$file")")
    else
        rm -f "$tmp"
    fi
}

if command -v pacman >/dev/null; then
    # Explicitly installed official packages. lib32-vulkan-radeon stays pinned so
    # a fresh install picks the right 32-bit Vulkan driver for Steam.
    write "$DIR/pkglist-repo.txt" \
"# Explicitly installed official-repo packages. Regenerated by bin/update-pkglists
# (lib32-vulkan-radeon pinned so Steam's 32-bit Vulkan provider is chosen correctly)" \
        < <({ pacman -Qqen; echo lib32-vulkan-radeon; } | sort -u)

    # Explicitly installed AUR packages; install.sh bootstraps yay itself.
    write "$DIR/pkglist-aur.txt" \
"# Explicitly installed AUR packages (yay itself is bootstrapped by install.sh).
# Regenerated by bin/update-pkglists" \
        < <(pacman -Qqem | grep -vE '^yay(-debug)?$' || true)

    if command -v flatpak >/dev/null; then
        write "$DIR/flatpaks.txt" \
"# Flatpak apps, installed system-wide from Flathub by install.sh.
# Regenerated by bin/update-pkglists" \
            < <(flatpak list --system --app --columns=application)
    fi

elif command -v rpm >/dev/null && [[ -d $DIR/tumbleweed ]]; then
    # zypper has no "explicitly installed" query like pacman -Qqen, so:
    #   everything installed
    #   - what the fresh install already had (baseline, saved by
    #     install-tumbleweed.sh before it installed anything)
    #   - what was only pulled in as a dependency (zypp's AutoInstalled)
    #   + whatever is already in the list and still installed.
    # Only the rpm database is read -- no zypp lock, so this works from
    # inside the commit plugin while zypper is still running.
    baseline=${XDG_STATE_HOME:-~/.local/state}/hyprland-dotfiles/tumbleweed-baseline.txt
    list=$DIR/tumbleweed/packages.txt
    if [[ -f $baseline ]]; then
        installed=$(rpm -qa --qf '%{NAME}\n' | grep -v '^gpg-pubkey$' | LC_ALL=C sort -u)
        write "$list" \
"# Explicitly installed openSUSE packages (official repos, Brave, Packman).
# Regenerated by bin/update-pkglists" \
            < <({
                LC_ALL=C comm -23 <(echo "$installed") \
                    <(cat "$baseline" /var/lib/zypp/AutoInstalled 2>/dev/null | LC_ALL=C sort -u)
                grep -vE '^\s*(#|$)' "$list" | LC_ALL=C sort -u | LC_ALL=C comm -12 - <(echo "$installed")
            } | LC_ALL=C sort -fu)
    else
        echo "update-pkglists: no $baseline yet (install-tumbleweed.sh writes it) -- package list left alone" >&2
    fi

    if command -v flatpak >/dev/null; then
        write "$DIR/tumbleweed/flatpaks.txt" \
"# Flatpak apps, installed system-wide from Flathub by install-tumbleweed.sh.
# Regenerated by bin/update-pkglists" \
            < <(flatpak list --system --app --columns=application)
    fi
fi

if [[ ${#changed[@]} -gt 0 ]]; then
    echo "update-pkglists: updated ${changed[*]} in $DIR (not committed)"
fi
