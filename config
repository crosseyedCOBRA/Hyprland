# ============================================================
# SWAY CONFIG — converted from hyprland.lua
# Place this file at ~/.config/sway/config
# ============================================================


# ==================
# == MONITORS     ==
# ==================

# DP-1 — primary, 165Hz, offset down 439px to align with rotated DP-2
output DP-1 {
    mode     1920x1080@165Hz
    position 0 439
    scale    1
}

# DP-2 — 144Hz, rotated 270 degrees (transform 3), top of stack
output DP-2 {
    mode      1920x1080@144Hz
    position  1920 0
    scale     1
    transform 270
}

# DP-3 — 144Hz, right of DP-1, offset down 439px to match DP-1 height
output DP-3 {
    mode     1920x1080@144Hz
    position 3000 439
    scale    1
}

# HDMI-A-1 — mirrors DP-1 via wl-mirror (Sway has no native mirror)
# This output is disabled as a real display; wl-mirror handles the mirroring
output HDMI-A-1 disable


# ==================
# == VARIABLES    ==
# ==================

set $mod        Mod4
set $terminal   kitty
set $filemanager thunar
set $menu       rofi -show drun -show-icons


# ==================
# == AUTOSTART    ==
# ==================

# Status bar
exec_always --no-startup-id waybar

# Mirror DP-1 onto HDMI-A-1
exec_always --no-startup-id wl-mirror -b export-dmabuf --fullscreen-output DP-1 HDMI-A-1

# Network applet
exec_always --no-startup-id nm-applet --indicator

# Bluetooth applet
exec_always --no-startup-id blueman-applet

# Polkit authentication agent
exec_always --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

# Notifications
exec_always --no-startup-id mako

# Disk automounting
exec_always --no-startup-id udiskie --tray

# PipeWire / audio (user services should already be enabled, but belt-and-braces)
exec_always --no-startup-id systemctl --user start pipewire pipewire-pulse wireplumber


# ==================
# == ENVIRONMENT  ==
# ==================

# Cursor
seat seat0 xcursor_theme Bibata-Modern-Ice 24

# Wayland-specific env vars (also set in /etc/environment for GTK/Qt apps)
exec systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway


# ==================
# == LOOK & FEEL  ==
# ==================

# Gaps (matches gaps_in = 5, gaps_out = 5 from Hyprland config)
gaps inner 5
gaps outer 5

# Border size
default_border          pixel 3
default_floating_border pixel 3

# Border colors — converted from rgba(33ccffee)/rgba(00ff99ee) gradient
# Sway doesn't support gradient borders; using the first color as active
# class                 border    background text      indicator child_border
client.focused          #33ccff   #33ccff    #ffffff   #00ff99   #33ccff
client.unfocused        #595959   #595959    #888888   #595959   #595959
client.focused_inactive #595959   #595959    #888888   #595959   #595959
client.urgent           #ff0000   #ff0000    #ffffff   #ff0000   #ff0000

# Font
font pango:Droid Sans 10

# Layout — Sway uses i3's splith/splitv which maps to Hyprland's dwindle
# Default split is horizontal, toggle with $mod+e
workspace_layout default


# ==================
# == ANIMATIONS   ==
# ==================

# Sway does not support animations natively.
# Install and enable swayfx (a Sway fork) if you want blur/animations/rounding.
# The blur and corner rounding from your Hyprland config cannot be replicated
# in stock Sway — everything else is faithfully converted.


# ==================
# == INPUT        ==
# ==================

input "type:keyboard" {
    xkb_layout  us
    xkb_variant ""
    xkb_model   ""
    xkb_options ""
    repeat_delay 300
    repeat_rate  30
}

input "type:pointer" {
    accel_profile flat
    pointer_accel 0
}

input "type:touchpad" {
    natural_scroll disabled
    tap enabled
}

# Per-device sensitivity — matches hl.device({ name = "epic-mouse-v1", sensitivity = -0.7 })
# Replace the identifier with your actual mouse identifier from: swaymsg -t get_inputs
# input "YOUR:MOUSE:IDENTIFIER" {
#     pointer_accel -0.7
# }


# ==================
# == KEYBINDINGS  ==
# ==================

# Terminal
bindsym $mod+Return exec $terminal

# Close window
bindsym $mod+q kill

# Exit Sway
bindsym $mod+m exec swaymsg exit

# File manager
bindsym $mod+e exec $filemanager

# Toggle floating
bindsym $mod+v floating toggle

# App launcher
bindsym $mod+space exec $menu

# Toggle split direction (replaces Hyprland's togglesplit/dwindle)
bindsym $mod+j layout toggle split

# Pseudo/toggle fullscreen (replaces hl.dsp.window.pseudo)
bindsym $mod+p fullscreen toggle

# Move focus with arrow keys
bindsym $mod+Left  focus left
bindsym $mod+Right focus right
bindsym $mod+Up    focus up
bindsym $mod+Down  focus down

# Move focused window with arrow keys
bindsym $mod+Shift+Left  move left
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+Up    move up
bindsym $mod+Shift+Down  move down

# Switch workspaces 1-10
bindsym $mod+1  workspace number 1
bindsym $mod+2  workspace number 2
bindsym $mod+3  workspace number 3
bindsym $mod+4  workspace number 4
bindsym $mod+5  workspace number 5
bindsym $mod+6  workspace number 6
bindsym $mod+7  workspace number 7
bindsym $mod+8  workspace number 8
bindsym $mod+9  workspace number 9
bindsym $mod+0  workspace number 10

# Move window to workspace
bindsym $mod+Shift+1  move container to workspace number 1
bindsym $mod+Shift+2  move container to workspace number 2
bindsym $mod+Shift+3  move container to workspace number 3
bindsym $mod+Shift+4  move container to workspace number 4
bindsym $mod+Shift+5  move container to workspace number 5
bindsym $mod+Shift+6  move container to workspace number 6
bindsym $mod+Shift+7  move container to workspace number 7
bindsym $mod+Shift+8  move container to workspace number 8
bindsym $mod+Shift+9  move container to workspace number 9
bindsym $mod+Shift+0  move container to workspace number 10

# Scratchpad (replaces Hyprland special workspace "magic")
bindsym $mod+Shift+s move scratchpad
bindsym $mod+s       scratchpad show

# Scroll through workspaces with mouse wheel
bindsym --whole-window $mod+button4 workspace prev
bindsym --whole-window $mod+button5 workspace next

# Move and resize windows with mouse
floating_modifier $mod normal

# Reload config
bindsym $mod+Shift+c reload

# Lock screen
bindsym $mod+l exec swaylock -f -c 000000

# Screenshot — full screen
bindsym Print exec grim ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png

# Screenshot — region select
bindsym $mod+Print exec grim -g "$(slurp)" ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png

# Volume keys
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioMute        exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioMicMute     exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

# Brightness keys
bindsym --locked XF86MonBrightnessUp   exec brightnessctl -e4 -n2 set 5%+
bindsym --locked XF86MonBrightnessDown exec brightnessctl -e4 -n2 set 5%-

# Media keys
bindsym --locked XF86AudioNext  exec playerctl next
bindsym --locked XF86AudioPause exec playerctl play-pause
bindsym --locked XF86AudioPlay  exec playerctl play-pause
bindsym --locked XF86AudioPrev  exec playerctl previous

# Resize mode
mode "resize" {
    bindsym Left  resize shrink width  10px
    bindsym Right resize grow   width  10px
    bindsym Up    resize shrink height 10px
    bindsym Down  resize grow   height 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"


# ==================
# == WINDOW RULES ==
# ==================

# Steam games — fullscreen
for_window [class="steam_app_.*"]  fullscreen enable

# Heroic / Wine — fullscreen
for_window [class="heroic"]        fullscreen enable
for_window [class="wine"]          fullscreen enable

# Floating windows
for_window [window_role="dialog"]        floating enable
for_window [window_role="pop-up"]        floating enable
for_window [window_type="dialog"]        floating enable
for_window [window_type="utility"]       floating enable
for_window [window_type="notification"]  floating enable

# Fix XWayland empty class/title windows — matches the no_focus rule from Hyprland
for_window [class="^$" title="^$" shell="xwayland"] floating enable, no_focus


# ==================
# == IDLE CONFIG  ==
# ==================

exec swayidle -w \
    timeout 300  'swaylock -f -c 000000' \
    timeout 600  'swaymsg "output * power off"' \
    resume       'swaymsg "output * power on"' \
    before-sleep 'swaylock -f -c 000000'


